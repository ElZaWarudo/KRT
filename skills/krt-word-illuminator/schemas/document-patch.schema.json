{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://krt.local/schemas/document-patch.schema.json",
  "title": "KRT Word document patch",
  "type": "object",
  "required": ["operations"],
  "properties": {
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "description": "Replace a uniquely matched plain-text paragraph containing exactly one run and no inline semantic nodes.",
            "required": ["op", "old", "new"],
            "properties": {
              "op": {"const": "replace_paragraph"},
              "old": {"type": "string", "minLength": 1},
              "new": {"type": "string"},
              "all": {"type": "boolean"}
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["op", "heading", "blocks"],
            "properties": {
              "op": {"const": "insert_after_heading"},
              "heading": {"type": "string", "minLength": 1},
              "blocks": {"type": "array", "items": {"type": "object"}}
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["op", "sections"],
            "properties": {
              "op": {"const": "append_sections"},
              "sections": {"type": "array", "items": {"type": "object"}, "minItems": 1}
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["op", "properties"],
            "properties": {
              "op": {"const": "set_core_properties"},
              "properties": {
                "type": "object",
                "properties": {
                  "title": {"type": "string"},
                  "subject": {"type": "string"},
                  "author": {"type": "string"},
                  "keywords": {"type": "string"},
                  "comments": {"type": "string"}
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "additionalProperties": false
}
