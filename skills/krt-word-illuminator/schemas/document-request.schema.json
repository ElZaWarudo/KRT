{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://krt.local/schemas/document-request.schema.json",
  "title": "KRT Word document request",
  "type": "object",
  "required": ["document_type", "objective", "title", "sections", "output"],
  "properties": {
    "document_type": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "subtitle": {"type": "string"},
    "audience": {"type": "string"},
    "language": {"type": "string", "default": "en"},
    "tone": {"type": "string"},
    "output": {"type": "string", "minLength": 1},
    "template": {"type": "string"},
    "required_sections": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "sources": {
      "type": "array",
      "items": {
        "oneOf": [
          {"type": "string", "minLength": 1},
          {
            "type": "object",
            "required": ["id", "path"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "path": {"type": "string", "minLength": 1},
              "kind": {"type": "string"}
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "document": {
      "type": "object",
      "properties": {
        "author": {"type": "string"},
        "subject": {"type": "string"},
        "keywords": {"type": "string"},
        "page_size": {"enum": ["A4", "LETTER"]},
        "toc": {"type": "boolean"},
        "header": {"type": "string"},
        "footer": {"type": "string"},
        "page_numbers": {"type": "boolean"},
        "margins_cm": {
          "type": "object",
          "properties": {
            "top": {"type": "number", "exclusiveMinimum": 0},
            "right": {"type": "number", "exclusiveMinimum": 0},
            "bottom": {"type": "number", "exclusiveMinimum": 0},
            "left": {"type": "number", "exclusiveMinimum": 0}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["heading", "blocks"],
        "properties": {
          "heading": {"type": "string", "minLength": 1},
          "level": {"type": "integer", "minimum": 1, "maximum": 3},
          "blocks": {
            "type": "array",
            "items": {"$ref": "#/$defs/block"}
          }
        },
        "additionalProperties": false
      }
    },
    "unverified_claims": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "properties": {
        "provenance": {
          "enum": ["source", "user", "inference", "pending", "editorial"]
        },
        "source_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "block": {
      "oneOf": [
        {
          "allOf": [
            {"$ref": "#/$defs/provenance"},
            {
              "type": "object",
              "required": ["type", "text"],
              "properties": {
                "type": {"enum": ["paragraph", "quote", "note", "warning", "code"]},
                "text": {"type": "string"}
              }
            }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            {"$ref": "#/$defs/provenance"},
            {
              "type": "object",
              "required": ["type", "items"],
              "properties": {
                "type": {"enum": ["bullets", "numbered"]},
                "items": {"type": "array", "items": {"type": "string"}}
              }
            }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            {"$ref": "#/$defs/provenance"},
            {
              "type": "object",
              "required": ["type", "headers", "rows"],
              "properties": {
                "type": {"const": "table"},
                "headers": {"type": "array", "items": {"type": "string"}, "minItems": 1},
                "rows": {
                  "type": "array",
                  "items": {"type": "array", "items": {"type": ["string", "number", "boolean", "null"]}}
                },
                "caption": {"type": "string"},
                "allow_row_split": {"type": "boolean"}
              }
            }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            {"$ref": "#/$defs/provenance"},
            {
              "type": "object",
              "required": ["type", "path", "alt_text"],
              "properties": {
                "type": {"const": "figure"},
                "path": {"type": "string", "minLength": 1},
                "alt_text": {"type": "string", "minLength": 1},
                "caption": {"type": "string"},
                "width_cm": {"type": "number", "exclusiveMinimum": 0}
              }
            }
          ],
          "unevaluatedProperties": false
        },
        {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": {"enum": ["page_break"]}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "orientation"],
          "properties": {
            "type": {"const": "section_break"},
            "orientation": {"enum": ["portrait", "landscape"]}
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "additionalProperties": false
}

